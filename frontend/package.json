{
  "name": "xscience-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "e2e": "esbuild --bundle --platform=node --format=cjs --alias:@=./src --inject:scripts/stub-node.js --outfile=node_modules/.cache/e2e.cjs scripts/e2e.ts && node node_modules/.cache/e2e.cjs",
    "smoke": "esbuild --bundle --platform=node --format=cjs --jsx=automatic --alias:@=./src --inject:scripts/stub.js --outfile=node_modules/.cache/smoke.cjs scripts/smoke.tsx && node node_modules/.cache/smoke.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
