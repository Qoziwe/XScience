# Окружение бэкенда XScience. Секреты не коммитить.
XSCI_ENV=development
XSCI_SECRET_KEY=change-me
XSCI_PORT=5000
XSCI_DB=./data/xscience.sqlite3

# §6.5 — сессия и лимиты входа
XSCI_SESSION_ABSOLUTE_S=28800
XSCI_SESSION_IDLE_S=900
XSCI_PASSWORD_MAX_ATTEMPTS=5
XSCI_PASSWORD_LOCK_S=30
XSCI_CODE_MAX_ATTEMPTS=3
# В проде обязательно 1 (HTTPS); в dev Vite проксирует по http.
XSCI_COOKIE_SECURE=0

# [ПРОТОТИП] статический код второго фактора вместо TOTP.
# В XSCI_ENV=production пусто по умолчанию — демо-вход выключен.
XSCI_DEMO_CODE=123456

# §11.4 [МАКЕТ] задержка «передачи отчёта на Землю», секунды
XSCI_REPORT_SEND_DELAY_S=2.5
XSCI_REPORT_WORKER=1

# Нужно только если фронт и бэк на разных origin (в dev не нужно)
XSCI_CORS_ORIGIN=

# --- ИИ-модуль (§2.2, §15, §17.3) -------------------------------------------
# Подключается любой провайдер. provider:
#   openai_compat — любой OpenAI-совместимый шлюз: OpenRouter и прочие роутеры,
#                   Groq, Together, DeepSeek, Ollama, LM Studio, vLLM…
#                   (синонимы: openai, openrouter, ollama, lmstudio, vllm, groq, together)
#   anthropic     — Anthropic Messages API (синоним: claude)
#   google        — Google AI Studio / Gemini (синонимы: gemini, aistudio, googleai)
#   none          — ИИ выключен, тексты пишут детерминированные правила §15
XSCI_AI_PROVIDER=none
XSCI_AI_MODEL=
XSCI_AI_API_KEY=
XSCI_AI_BASE_URL=
XSCI_AI_TIMEOUT_S=25
XSCI_AI_MAX_TOKENS=2000
# Произвольные параметры запроса для выбранного API (JSON):
# OpenAI-совместимые — {"temperature":0.3}; Anthropic — {"output_config":{"effort":"low"}};
# Google — {"generationConfig":{"temperature":0.3}}
XSCI_AI_EXTRA_JSON=

# Любое поле можно переопределить для отдельной функции и выключить её:
#   XSCI_AI_TEXTS=0 / XSCI_AI_TEXTS_PROVIDER / _MODEL / _API_KEY / _BASE_URL / _EXTRA_JSON
#   XSCI_AI_VISION=0 / XSCI_AI_VISION_PROVIDER / _MODEL / _API_KEY / _BASE_URL / …
# Распознавание фото требует модель с поддержкой изображений.
XSCI_AI_VISION_MODEL=

# Примеры (ключи подставить свои):
#   OpenRouter:        XSCI_AI_PROVIDER=openrouter
#                      XSCI_AI_BASE_URL=https://openrouter.ai/api/v1
#                      XSCI_AI_MODEL=<издатель>/<модель>
#   Anthropic:         XSCI_AI_PROVIDER=anthropic   XSCI_AI_MODEL=claude-opus-5
#   Google AI Studio:  XSCI_AI_PROVIDER=google      XSCI_AI_MODEL=<модель Gemini>
#   Локальная Ollama:  XSCI_AI_PROVIDER=ollama      XSCI_AI_BASE_URL=http://127.0.0.1:11434/v1
#                      XSCI_AI_MODEL=<модель>       XSCI_AI_API_KEY=ollama

# --- Фото пламени (§17.3, §18.7) -------------------------------------------
XSCI_PHOTO_DIR=./data/photos
XSCI_PHOTO_MAX_MB=8
