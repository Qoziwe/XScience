# XScience backend environment. Do not commit secrets.
XSCI_ENV=development
XSCI_SECRET_KEY=change-me
XSCI_PORT=5000
XSCI_DB=./data/xscience.sqlite3

# §6.5 — session and login limits
XSCI_SESSION_ABSOLUTE_S=28800
XSCI_SESSION_IDLE_S=900
XSCI_PASSWORD_MAX_ATTEMPTS=5
XSCI_PASSWORD_LOCK_S=30
XSCI_CODE_MAX_ATTEMPTS=3
# Must be 1 in production (HTTPS); in dev, Vite proxies over http.
XSCI_COOKIE_SECURE=0
# Only needed if the frontend and backend are different subdomains of the same
# domain (example here for xscience.andatra.space (frontend, GitHub Pages) +
# xscienceapi.andatra.space (backend)): a shared cookie Domain, otherwise the
# client-side JS on the frontend subdomain can't read the CSRF cookie. Empty —
# the cookie is host-oriented (default, fine for a single host).
# XSCI_COOKIE_DOMAIN=.andatra.space

# [PROTOTYPE] a static second-factor code instead of TOTP.
# Empty by default in XSCI_ENV=production — demo login is disabled.
XSCI_DEMO_CODE=123456

# §11.4 [MOCK-UP] "report transmission to Earth" delay, in seconds
XSCI_REPORT_SEND_DELAY_S=2.5
XSCI_REPORT_WORKER=1

# Only needed if the frontend and backend are on different origins (not
# needed in dev). Example — frontend on GitHub Pages (xscience.andatra.space),
# backend here (xscienceapi.andatra.space):
# XSCI_CORS_ORIGIN=https://xscience.andatra.space
XSCI_CORS_ORIGIN=

# --- AI module (§2.2, §15, §17.3) -------------------------------------------
# Any provider can be plugged in. provider:
#   openai_compat — any OpenAI-compatible gateway: OpenRouter and other routers,
#                   Groq, Together, DeepSeek, Ollama, LM Studio, vLLM…
#                   (aliases: openai, openrouter, ollama, lmstudio, vllm, groq, together)
#   anthropic     — Anthropic Messages API (alias: claude)
#   google        — Google AI Studio / Gemini (aliases: gemini, aistudio, googleai)
#   none          — AI disabled, texts are written by the deterministic rules in §15
XSCI_AI_PROVIDER=none
XSCI_AI_MODEL=
XSCI_AI_API_KEY=
XSCI_AI_BASE_URL=
XSCI_AI_TIMEOUT_S=25
XSCI_AI_MAX_TOKENS=2000
# Arbitrary request parameters for the selected API (JSON):
# OpenAI-compatible — {"temperature":0.3}; Anthropic — {"output_config":{"effort":"low"}};
# Google — {"generationConfig":{"temperature":0.3}}
XSCI_AI_EXTRA_JSON=

# Any field can be overridden for a specific function and disabled individually:
#   XSCI_AI_TEXTS=0 / XSCI_AI_TEXTS_PROVIDER / _MODEL / _API_KEY / _BASE_URL / _EXTRA_JSON
#   XSCI_AI_VISION=0 / XSCI_AI_VISION_PROVIDER / _MODEL / _API_KEY / _BASE_URL / …
# Photo recognition requires a model with image support.
XSCI_AI_VISION_MODEL=

# Examples (substitute your own keys):
#   OpenRouter:        XSCI_AI_PROVIDER=openrouter
#                      XSCI_AI_BASE_URL=https://openrouter.ai/api/v1
#                      XSCI_AI_MODEL=<publisher>/<model>
#   Anthropic:         XSCI_AI_PROVIDER=anthropic   XSCI_AI_MODEL=claude-opus-5
#   Google AI Studio:  XSCI_AI_PROVIDER=google      XSCI_AI_MODEL=<Gemini model>
#   Local Ollama:      XSCI_AI_PROVIDER=ollama      XSCI_AI_BASE_URL=http://127.0.0.1:11434/v1
#                      XSCI_AI_MODEL=<model>        XSCI_AI_API_KEY=ollama

# --- Flame photos (§17.3, §18.7) -------------------------------------------
XSCI_PHOTO_DIR=./data/photos
XSCI_PHOTO_MAX_MB=8
